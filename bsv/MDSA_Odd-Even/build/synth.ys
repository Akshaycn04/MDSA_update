# Read all Verilog files
read_verilog verilog_dir/mk_cae.v
read_verilog verilog_dir/mk_oddeven_sorter.v
read_verilog verilog_dir/mk_mdsa_oddeven.v

# Set top module and check hierarchy
hierarchy -check -top mk_mdsa_oddeven

# Start synthesis
proc
opt
memory
opt
techmap
opt

# Map to gates and optimize
abc -g gates

# Show statistics
stat